{
  "name": "nqt/theme-sample",
  "version": "1.0.0",
  "description": "Theme mẫu cho hệ thống theme động.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Nqt\\ThemeSample\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nqt\\ThemeSample\\ThemeSampleServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
