{
  "name": "nqt/theme-vinahentai",
  "version": "1.0.2",
  "description": "Theme giao diện VinaHentai (Blade, asset, route) cho ứng dụng Laravel.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Nqt\\ThemeVinahentai\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nqt\\ThemeVinahentai\\ThemeVinahentaiServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
